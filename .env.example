# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Client (Vite dev server origin) ───────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── SQLite ────────────────────────────────────────────────────────────────────
SQLITE_PATH=./data/lob.db

# ── S3-compatible storage (DigitalOcean Spaces in prod, MinIO locally) ────────
# Local dev defaults — matches docker-compose.yml MinIO service
SPACES_KEY=minioadmin
SPACES_SECRET=minioadmin
SPACES_BUCKET=lob-online-dev
SPACES_ENDPOINT=http://localhost:9000
SPACES_FORCE_PATH_STYLE=true
# Required by the AWS SDK v3 S3 client even for MinIO (use us-east-1 as a dummy value)
SPACES_REGION=us-east-1
# Production overrides (DigitalOcean Spaces):
# SPACES_KEY=your-spaces-access-key
# SPACES_SECRET=your-spaces-secret-key
# SPACES_BUCKET=lob-online-games
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_FORCE_PATH_STYLE=false
# SPACES_REGION=us-east-1

# ── Upgrade note (PR #639) ────────────────────────────────────────────────────
# If upgrading from before PR #639, rename env vars in your .env and deploy config:
#   DO_SPACES_KEY      → SPACES_KEY
#   DO_SPACES_SECRET   → SPACES_SECRET
#   DO_SPACES_BUCKET   → SPACES_BUCKET
#   DO_SPACES_ENDPOINT → SPACES_ENDPOINT
#   DO_SPACES_REGION   → SPACES_REGION (newly required)

# ── Discord Webhook ────────────────────────────────────────────────────────────
# Local dev: run `npm run discord:sink` to start a local listener on port 4040
# In production this var is not read (notifyWebhook uses the per-game discord_webhook DB column).
# STAGING RISK: notifyWebhook honours DISCORD_WEBHOOK_URL when NODE_ENV !== 'production'.
# A staging deployment with this var set will POST game-action payloads to the override URL,
# bypassing the discord.com allowlist. Do not set this var in staging environments.
DISCORD_WEBHOOK_URL=http://localhost:4040

# ── Tools ─────────────────────────────────────────────────────────────────────
# Enable the map editor dev tool (never enable on production)
MAP_EDITOR_ENABLED=false
# VITE_-prefixed vars are compiled into the public client bundle — never put secrets here.
VITE_MAP_EDITOR_ENABLED=false

# ── Claude Code agent-teams plugin ────────────────────────────────────────────
# Set to 1 to enable /team-spawn and other agent-teams commands
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# ── Session ───────────────────────────────────────────────────────────────────
# Required in all non-test environments — server.js fails fast at startup if unset (#SEC-M2)
SESSION_SECRET=dev-secret-local

# ── Discord OAuth ──────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback
# Poorman local auth without real Discord credentials: POST /auth/dev/login { code }
# creates a synthetic session. Gated here so it is never mounted in production.
AUTH_DEV_MODE=true
